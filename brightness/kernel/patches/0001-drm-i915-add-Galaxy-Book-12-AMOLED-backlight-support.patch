diff --git a/drivers/gpu/drm/i915/display/intel_dp_samsung_amoled.c b/drivers/gpu/drm/i915/display/intel_dp_samsung_amoled.c
new file mode 100644
index 0000000..c7fda9a
--- /dev/null
+++ b/drivers/gpu/drm/i915/display/intel_dp_samsung_amoled.c
@@ -0,0 +1,619 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Samsung Galaxy Book 12 AMOLED backlight control
+ *
+ * The private panel protocol, calibration algorithm and register tables are
+ * derived from SamsungGalaxyBook12 by Aurelien Croc (AP2C), Copyright (C)
+ * 2022-2023. Kernel integration and fixed-point conversion Copyright (C) 2026
+ * Samsung-Galaxy-Book-12-Linux contributors.
+ */
+
+#include <linux/delay.h>
+#include <linux/dmi.h>
+#include <linux/math64.h>
+#include <linux/slab.h>
+
+#include <drm/display/drm_dp_helper.h>
+#include <drm/drm_edid.h>
+#include <drm/drm_print.h>
+
+#include "intel_display_core.h"
+#include "intel_display_types.h"
+#include "intel_dp.h"
+#include "intel_dp_samsung_amoled.h"
+#include "intel_dp_samsung_amoled_tables.h"
+
+#define SAMSUNG_AMOLED_MIN_BRIGHTNESS 10
+#define SAMSUNG_AMOLED_MAX_BRIGHTNESS 101
+#define SAMSUNG_AMOLED_SCALE 1000000000000LL
+#define SAMSUNG_AMOLED_V72 (72LL * SAMSUNG_AMOLED_SCALE / 10)
+#define SAMSUNG_AMOLED_V15 (15LL * SAMSUNG_AMOLED_SCALE / 10)
+
+struct intel_samsung_amoled {
+	struct intel_connector *connector;
+	u8 reg2_26;
+	u8 current_level;
+	u8 color_profile[ARRAY_SIZE(samsung_color_profile_base)];
+	u8 channel_adjustment[0x42][33];
+};
+
+static const struct dmi_system_id samsung_amoled_dmi_table[] = {
+	{
+		.matches = {
+			DMI_MATCH(DMI_SYS_VENDOR, "SAMSUNG ELECTRONICS CO., LTD."),
+			DMI_MATCH(DMI_PRODUCT_NAME, "Galaxy Book 12"),
+		},
+	},
+	{}
+};
+
+static int samsung_aux_write(struct drm_dp_aux *aux, unsigned int address,
+			     const void *data, size_t size)
+{
+	int ret = drm_dp_dpcd_write(aux, address, (void *)data, size);
+
+	return ret == size ? 0 : ret < 0 ? ret : -EIO;
+}
+
+static int samsung_aux_readb(struct drm_dp_aux *aux, unsigned int address,
+			     u8 *value)
+{
+	int ret = drm_dp_dpcd_readb(aux, address, value);
+
+	return ret == 1 ? 0 : ret < 0 ? ret : -EIO;
+}
+
+static int samsung_access_private_registers(struct drm_dp_aux *aux)
+{
+	static const char command[] = "PARAAUX-REG";
+	int attempt;
+
+	for (attempt = 0; attempt < 5; attempt++) {
+		u8 response;
+		int i, ret;
+
+		for (i = 0; i < sizeof(command) - 1; i++) {
+			ret = samsung_aux_write(aux, 0x490, &command[i], 1);
+			if (ret)
+				return ret;
+		}
+		ret = samsung_aux_readb(aux, 0x490, &response);
+		if (ret)
+			return ret;
+		if (response)
+			return 0;
+	}
+
+	return -EIO;
+}
+
+static int samsung_read_display_register(struct drm_dp_aux *aux, u8 reg,
+					 int type, u8 *value)
+{
+	u8 command[3];
+	int ret;
+
+	command[0] = 2;
+	command[1] = 0x7f;
+	command[2] = 1;
+	ret = samsung_aux_write(aux, 0x491, command, 3);
+	if (ret)
+		return ret;
+	command[0] = 7;
+	command[1] = 0xff;
+	command[2] = 4;
+	ret = samsung_aux_write(aux, 0x491, command, 3);
+	if (ret)
+		return ret;
+	command[0] = 3;
+	command[1] = type ? 4 : 2;
+	ret = samsung_aux_write(aux, 0x492, command, 2);
+	if (ret)
+		return ret;
+	command[0] = 6;
+	command[1] = reg;
+	ret = samsung_aux_write(aux, 0x492, command, 2);
+	if (ret)
+		return ret;
+	command[0] = 0x0a;
+	ret = samsung_aux_write(aux, 0x492, command, 1);
+	if (ret)
+		return ret;
+
+	return samsung_aux_readb(aux, 0x493, value);
+}
+
+static int samsung_read_display_register2(struct drm_dp_aux *aux,
+					  const u8 selector[3], u8 *value)
+{
+	u8 command[3];
+	int ret;
+
+	command[0] = 2;
+	command[1] = 0x7f;
+	command[2] = 1;
+	ret = samsung_aux_write(aux, 0x491, command, 3);
+	if (ret)
+		return ret;
+	command[0] = 7;
+	command[1] = 0xff;
+	command[2] = 4;
+	ret = samsung_aux_write(aux, 0x491, command, 3);
+	if (ret)
+		return ret;
+	command[0] = 0;
+	command[1] = selector[0];
+	ret = samsung_aux_write(aux, 0x492, command, 2);
+	if (ret)
+		return ret;
+	command[0] = 1;
+	command[1] = selector[2];
+	ret = samsung_aux_write(aux, 0x492, command, 2);
+	if (ret)
+		return ret;
+	command[0] = 2;
+	command[1] = selector[1];
+	ret = samsung_aux_write(aux, 0x492, command, 2);
+	if (ret)
+		return ret;
+	command[0] = 7;
+	command[1] = 0x0c;
+	ret = samsung_aux_write(aux, 0x491, command, 2);
+	if (ret)
+		return ret;
+
+	return samsung_aux_readb(aux, 0x493, value);
+}
+
+static int samsung_read_brightness_registers(struct drm_dp_aux *aux,
+					     int output[10][3])
+{
+	static const u8 selectors[33][3] = {
+		{ 2, 0, 0 },	{ 2, 0, 0x80 }, { 2, 1, 0 },	{ 2, 1, 0x80 },
+		{ 2, 2, 0 },	{ 2, 2, 0x80 }, { 2, 3, 0 },	{ 2, 3, 0x80 },
+		{ 2, 4, 0 },	{ 2, 4, 0x80 }, { 2, 5, 0 },	{ 4, 0, 0 },
+		{ 4, 0, 0x80 }, { 4, 1, 0 },	{ 4, 1, 0x80 }, { 4, 2, 0 },
+		{ 4, 2, 0x80 }, { 4, 3, 0 },	{ 4, 3, 0x80 }, { 4, 4, 0 },
+		{ 4, 4, 0x80 }, { 4, 5, 0 },	{ 8, 0, 0 },	{ 8, 0, 0x80 },
+		{ 8, 1, 0 },	{ 8, 1, 0x80 }, { 8, 2, 0 },	{ 8, 2, 0x80 },
+		{ 8, 3, 0 },	{ 8, 3, 0x80 }, { 8, 4, 0 },	{ 8, 4, 0x80 },
+		{ 8, 5, 0 },
+	};
+	u8 values[33];
+	int i, channel, ret;
+
+	for (i = 0; i < ARRAY_SIZE(values); i++) {
+		ret = samsung_read_display_register2(aux, selectors[i],
+						     &values[i]);
+		if (ret)
+			return ret;
+	}
+	memset(output, 0, sizeof(int) * 10 * 3);
+	output[1][0] = values[0x08];
+	output[1][1] = values[0x13];
+	output[1][2] = values[0x1e];
+	for (i = 0; i < 8; i++) {
+		output[i + 2][0] = values[i];
+		output[i + 2][1] = values[i + 0x0b];
+		output[i + 2][2] = values[i + 0x16];
+	}
+	for (channel = 0; channel < 3; channel++) {
+		if (values[9 + channel * 0x0b] >= 0x80)
+			output[9][channel] += 0x100;
+	}
+
+	return 0;
+}
+
+static int samsung_prepare_channel_adjustment(struct intel_samsung_amoled *data,
+					      int raw[10][3])
+{
+	s64 normalized[10][3] = {};
+	s64(*thresholds)[3];
+	int group, channel, slot;
+
+	thresholds = kcalloc(0x100, sizeof(*thresholds), GFP_KERNEL);
+	if (!thresholds)
+		return -ENOMEM;
+
+	for (channel = 0; channel < 3; channel++)
+		normalized[0][channel] = SAMSUNG_AMOLED_V72;
+	for (group = 9; group > 0; group--) {
+		int shift = samsung_adjustment_factor[group][0];
+		int maximum = samsung_adjustment_factor[group][1];
+
+		for (channel = 0; channel < 3; channel++) {
+			int value = raw[group][channel] + shift;
+			s64 range =
+				group == 9 ?
+					SAMSUNG_AMOLED_V72 -
+						SAMSUNG_AMOLED_V15 :
+					SAMSUNG_AMOLED_V72 -
+						normalized[group + 1][channel];
+
+			normalized[group][channel] =
+				SAMSUNG_AMOLED_V72 -
+				div_s64((s64)value * range, maximum);
+		}
+	}
+	for (group = 9; group > 0; group--) {
+		int first = samsung_first_index_per_group[group];
+		int count = first - samsung_first_index_per_group[group - 1];
+		int offset;
+
+		for (channel = 0; channel < 3; channel++) {
+			s64 previous = group > 1 ?
+					       normalized[group - 1][channel] :
+					       SAMSUNG_AMOLED_V72;
+			s64 value = normalized[group][channel];
+
+			for (offset = 0; offset < count; offset++)
+				thresholds[first - offset][channel] =
+					value +
+					div_s64((s64)offset *
+							(previous - value),
+						count);
+		}
+	}
+	for (channel = 0; channel < 3; channel++)
+		thresholds[0][channel] = SAMSUNG_AMOLED_V72;
+
+	for (slot = 0; slot < 0x42; slot++) {
+		u16 final[10][3] = {};
+		int pointer = 0;
+
+		for (group = 9; group > 0; group--) {
+			int shift = samsung_adjustment_factor[group][0];
+			int maximum = samsung_adjustment_factor[group][1];
+
+			for (channel = 0; channel < 3; channel++) {
+				s64 value =
+					thresholds[samsung_amoled_fraction_index
+							   [slot][group]]
+						  [channel];
+				s64 range =
+					SAMSUNG_AMOLED_V72 - SAMSUNG_AMOLED_V15;
+				int result;
+
+				if (group != 9)
+					range = SAMSUNG_AMOLED_V72 -
+						thresholds[samsung_amoled_fraction_index
+								   [slot]
+								   [group + 1]]
+							  [channel];
+				result = div64_s64((s64)maximum *
+							   (SAMSUNG_AMOLED_V72 -
+							    value),
+						   range) -
+					 shift;
+				result += samsung_brightness_shift[slot][group]
+								  [channel];
+				if (result < 0)
+					result = 0;
+				if (result > 0xff && group != 9)
+					result = 0xff;
+				final[group][channel] = result;
+			}
+		}
+		for (channel = 0; channel < 3; channel++)
+			final[0][channel] = raw[0][channel];
+		for (channel = 0; channel < 3; channel++) {
+			for (group = 2; group < 10; group++)
+				data->channel_adjustment[slot][pointer++] =
+					final[group][channel];
+			data->channel_adjustment[slot][pointer++] =
+				final[1][channel];
+			data->channel_adjustment[slot][pointer++] =
+				(final[9][channel] / 2) & 0x80;
+			data->channel_adjustment[slot][pointer++] =
+				final[0][channel];
+		}
+	}
+
+	kfree(thresholds);
+
+	return 0;
+}
+
+static void samsung_adjust_color_profile(struct intel_samsung_amoled *data,
+					 u8 reg26, u8 reg27, u8 reg28, u8 reg29)
+{
+	static const u8 indexes[] = { 0x67, 0x69, 0x6b };
+	s32 value[4], regs_a, regs_b;
+	int pointer, i;
+
+	regs_a = reg26 << 8 | reg27;
+	regs_b = (reg28 << 8 | reg29) << 10;
+	value[0] = (regs_b - 44032 * regs_a / 40 + 46080) >> 10;
+	value[1] = (regs_b - 317440 * regs_a / 297 - 3072) >> 10;
+	value[2] = (regs_b + 375808 * regs_a / 84 - 16696320) >> 10;
+	value[3] = (regs_b + 340992 * regs_a / 107 - 12693504) >> 10;
+	if (value[0] <= 0) {
+		if (value[1] >= 0)
+			pointer = value[2] > 0 ? 6 : (value[3] >> 31) + 5;
+		else
+			pointer = value[2] > 0 ? 9 : (value[3] >> 31) + 8;
+	} else {
+		pointer = value[2] > 0 ? 3 : (value[3] >> 31) + 2;
+	}
+	if (pointer - 1 > 8)
+		pointer = 1;
+	memcpy(data->color_profile, samsung_color_profile_base,
+	       sizeof(data->color_profile));
+	for (i = 0; i < ARRAY_SIZE(indexes); i++)
+		data->color_profile[indexes[i]] =
+			samsung_color_adj_a[pointer * 3 + i];
+}
+
+static int samsung_write_color_profile(struct intel_samsung_amoled *data)
+{
+	struct intel_dp *intel_dp = intel_attached_dp(data->connector);
+	u8 command[3] = { 0x0d, 0, data->color_profile[0] };
+	int i, ret;
+
+	ret = samsung_aux_write(&intel_dp->aux, 0x491, command, 3);
+	for (i = 1; !ret && i < ARRAY_SIZE(data->color_profile); i++) {
+		command[0] = i;
+		command[1] = data->color_profile[i];
+		ret = samsung_aux_write(&intel_dp->aux, 0x492, command, 2);
+	}
+
+	return ret;
+}
+
+static int samsung_write_brightness(struct intel_samsung_amoled *data,
+				    u32 level)
+{
+	struct intel_dp *intel_dp = intel_attached_dp(data->connector);
+	struct drm_dp_aux *aux = &intel_dp->aux;
+	u8 command[3];
+	u8 slot;
+	int i, ret;
+
+	level = clamp_t(u32, level, SAMSUNG_AMOLED_MIN_BRIGHTNESS,
+			SAMSUNG_AMOLED_MAX_BRIGHTNESS);
+	slot = samsung_adjustment_slot[level];
+	command[0] = 0x0f;
+	command[1] = 0xff;
+	command[2] = 0;
+	ret = samsung_aux_write(aux, 0x491, command, 3);
+	command[0] = 0x9d;
+	command[1] = samsung_brightness_c[level][0];
+	if (!ret)
+		ret = samsung_aux_write(aux, 0x492, command, 2);
+	command[0] = 0x9b;
+	command[1] = samsung_brightness_c[level][1];
+	if (!ret)
+		ret = samsung_aux_write(aux, 0x492, command, 2);
+	command[0] = 0x0f;
+	command[1] = 0xff;
+	command[2] = 2;
+	if (!ret)
+		ret = samsung_aux_write(aux, 0x491, command, 3);
+	command[0] = 0x30;
+	command[1] = samsung_brightness_c2[slot];
+	if (!ret)
+		ret = samsung_aux_write(aux, 0x492, command, 2);
+	command[0] = 0x33;
+	command[1] = data->reg2_26;
+	if (!ret)
+		ret = samsung_aux_write(aux, 0x492, command, 2);
+	command[0] = 0x0e;
+	command[1] = 0x80;
+	command[2] = level >= 100 ? 0x80 : 0x90;
+	if (!ret)
+		ret = samsung_aux_write(aux, 0x491, command, 3);
+	command[0] = 2;
+	command[1] = 0x7f;
+	command[2] = 1;
+	if (!ret)
+		ret = samsung_aux_write(aux, 0x491, command, 3);
+	command[0] = 7;
+	command[1] = 0xff;
+	command[2] = 4;
+	if (!ret)
+		ret = samsung_aux_write(aux, 0x491, command, 3);
+	for (i = 0; !ret && i < 33; i++) {
+		command[0] = 0x10 + i;
+		command[1] = data->channel_adjustment[slot][i];
+		ret = samsung_aux_write(aux, 0x492, command, 2);
+	}
+	usleep_range(1000, 1500);
+	command[0] = 0x32;
+	command[1] = 1;
+	if (!ret)
+		ret = samsung_aux_write(aux, 0x492, command, 2);
+	command[0] = 2;
+	command[1] = 0xeb;
+	command[2] = 0x91;
+	if (!ret)
+		ret = samsung_aux_write(aux, 0x491, command, 3);
+	command[0] = 9;
+	command[1] = 0xf0;
+	command[2] = 0xef;
+	if (!ret)
+		ret = samsung_aux_write(aux, 0x491, command, 3);
+	command[0] = 0xf9;
+	command[1] = samsung_brightness_a[level];
+	if (!ret)
+		ret = samsung_aux_write(aux, 0x492, command, 2);
+	command[0] = 0xf8;
+	command[1] = 0x19;
+	if (!ret)
+		ret = samsung_aux_write(aux, 0x492, command, 2);
+	command[0] = 2;
+	command[1] = 0xeb;
+	command[2] = 0x96;
+	if (!ret)
+		ret = samsung_aux_write(aux, 0x491, command, 3);
+	command[0] = 0x0e;
+	command[1] = 0x10;
+	command[2] = samsung_brightness_b[level][0];
+	if (!ret)
+		ret = samsung_aux_write(aux, 0x491, command, 3);
+	for (i = 1; !ret && i < 9; i++) {
+		command[0] = 0x10 + i;
+		command[1] = samsung_brightness_b[level][i];
+		ret = samsung_aux_write(aux, 0x492, command, 2);
+	}
+	if (!ret)
+		data->current_level = level;
+
+	return ret;
+}
+
+static u32 samsung_amoled_get_backlight(struct intel_connector *connector,
+					enum pipe pipe)
+{
+	struct intel_samsung_amoled *data =
+		connector->panel.backlight.samsung_amoled;
+
+	return data ? data->current_level : SAMSUNG_AMOLED_MAX_BRIGHTNESS;
+}
+
+static void
+samsung_amoled_set_backlight(const struct drm_connector_state *conn_state,
+			     u32 level)
+{
+	struct intel_connector *connector =
+		to_intel_connector(conn_state->connector);
+	struct intel_display *display = to_intel_display(connector);
+	struct intel_samsung_amoled *data =
+		connector->panel.backlight.samsung_amoled;
+	int ret;
+
+	if (!data)
+		return;
+	ret = samsung_write_brightness(data, level);
+	if (ret)
+		drm_err(display->drm,
+			"[CONNECTOR:%d:%s] AMOLED brightness write failed: %d\n",
+			connector->base.base.id, connector->base.name, ret);
+}
+
+static void
+samsung_amoled_enable_backlight(const struct intel_crtc_state *crtc_state,
+				const struct drm_connector_state *conn_state,
+				u32 level)
+{
+	struct intel_connector *connector =
+		to_intel_connector(conn_state->connector);
+	struct intel_display *display = to_intel_display(connector);
+	struct intel_samsung_amoled *data =
+		connector->panel.backlight.samsung_amoled;
+	struct intel_dp *intel_dp = intel_attached_dp(connector);
+	int ret;
+
+	if (!data)
+		return;
+	ret = samsung_access_private_registers(&intel_dp->aux);
+	if (!ret)
+		ret = samsung_write_color_profile(data);
+	if (!ret)
+		ret = samsung_write_brightness(data, level);
+	if (ret)
+		drm_err(display->drm,
+			"[CONNECTOR:%d:%s] AMOLED enable failed: %d\n",
+			connector->base.base.id, connector->base.name, ret);
+}
+
+static void
+samsung_amoled_disable_backlight(const struct drm_connector_state *conn_state,
+				 u32 level)
+{
+}
+
+static int samsung_amoled_setup_backlight(struct intel_connector *connector,
+					  enum pipe pipe)
+{
+	struct intel_display *display = to_intel_display(connector);
+	struct intel_panel *panel = &connector->panel;
+	struct intel_dp *intel_dp = intel_attached_dp(connector);
+	struct intel_samsung_amoled *data;
+	u8 registers[5];
+	int raw[10][3];
+	u32 initial_level = SAMSUNG_AMOLED_MAX_BRIGHTNESS;
+	int pwm_ret, ret, i;
+
+	pwm_ret = panel->backlight.pwm_funcs->setup(connector, pipe);
+	if (!pwm_ret && panel->backlight.max)
+		initial_level = DIV_ROUND_CLOSEST_ULL((u64)panel->backlight.level *
+						      SAMSUNG_AMOLED_MAX_BRIGHTNESS,
+						      panel->backlight.max);
+	data = kzalloc_obj(*data);
+	if (!data) {
+		ret = -ENOMEM;
+		goto fallback;
+	}
+	data->connector = connector;
+	ret = samsung_access_private_registers(&intel_dp->aux);
+	for (i = 0; !ret && i < 4; i++)
+		ret = samsung_read_display_register(&intel_dp->aux, 0x26 + i, 0,
+						    &registers[i]);
+	if (!ret)
+		ret = samsung_read_display_register(&intel_dp->aux, 0x26, 1,
+						    &registers[4]);
+	if (!ret)
+		ret = samsung_read_brightness_registers(&intel_dp->aux, raw);
+	if (!ret) {
+		samsung_adjust_color_profile(data, registers[0], registers[1],
+					     registers[2], registers[3]);
+		ret = samsung_prepare_channel_adjustment(data, raw);
+	}
+	if (ret) {
+		kfree(data);
+		goto fallback;
+	}
+	data->reg2_26 = registers[4];
+	data->current_level = clamp_t(u32, initial_level,
+				      SAMSUNG_AMOLED_MIN_BRIGHTNESS,
+				      SAMSUNG_AMOLED_MAX_BRIGHTNESS);
+	panel->backlight.samsung_amoled = data;
+	panel->backlight.min = SAMSUNG_AMOLED_MIN_BRIGHTNESS;
+	panel->backlight.max = SAMSUNG_AMOLED_MAX_BRIGHTNESS;
+	panel->backlight.level = data->current_level;
+	panel->backlight.enabled = false;
+	drm_info(display->drm,
+		 "[CONNECTOR:%d:%s] Samsung Galaxy Book 12 AMOLED backlight initialized\n",
+		 connector->base.base.id, connector->base.name);
+
+	return 0;
+
+fallback:
+	panel->backlight.funcs = panel->backlight.pwm_funcs;
+	drm_warn(display->drm,
+		 "[CONNECTOR:%d:%s] AMOLED setup failed (%d), falling back to PWM\n",
+		 connector->base.base.id, connector->base.name, ret);
+
+	return pwm_ret;
+}
+
+static const struct intel_panel_bl_funcs samsung_amoled_bl_funcs = {
+	.setup = samsung_amoled_setup_backlight,
+	.enable = samsung_amoled_enable_backlight,
+	.disable = samsung_amoled_disable_backlight,
+	.set = samsung_amoled_set_backlight,
+	.get = samsung_amoled_get_backlight,
+};
+
+int intel_dp_samsung_amoled_init_backlight(struct intel_connector *connector)
+{
+	struct intel_panel *panel = &connector->panel;
+	u32 panel_id;
+
+	if (!dmi_check_system(samsung_amoled_dmi_table) ||
+	    IS_ERR_OR_NULL(panel->fixed_edid))
+		return -ENODEV;
+	panel_id = drm_edid_get_panel_id(panel->fixed_edid);
+	if (panel_id != drm_edid_encode_panel_id('S', 'D', 'C', 0xa029))
+		return -ENODEV;
+	panel->backlight.funcs = &samsung_amoled_bl_funcs;
+
+	return 0;
+}
+
+void intel_dp_samsung_amoled_fini(struct intel_panel *panel)
+{
+	kfree(panel->backlight.samsung_amoled);
+	panel->backlight.samsung_amoled = NULL;
+}
