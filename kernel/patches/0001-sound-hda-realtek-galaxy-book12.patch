+/*
+ * The 2017 Galaxy Book 12 uses two vendor-controlled speaker amplifiers and
+ * routes both the speakers and the headset through pin 0x17.  The BIOS leaves
+ * the amplifiers uninitialised and the standard pin configuration describes
+ * 0x17 only as a fixed speaker, while headset presence is reported by the
+ * microphone pin 0x18.
+ */
+struct alc298_book12_reg {
+	unsigned short reg;
+	unsigned short val;
+};
