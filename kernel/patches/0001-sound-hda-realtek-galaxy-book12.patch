+static void alc298_book12_wait_coef(struct hda_codec *codec)
+{
+	int i;
+
+	for (i = 0; i < 500; i++) {
+		if (!(alc_read_coef_idx(codec, 0x26) & 0x4000))
+			return;
+		usleep_range(1000, 1100);
+	}
+	codec_warn(codec, "Galaxy Book 12: coefficient engine timeout\n");
+}
+
+static void alc298_book12_write_indirect(struct hda_codec *codec,
+					 unsigned short reg,
+					 unsigned short val)
+{
+	alc298_book12_wait_coef(codec);
+	alc_write_coef_idx(codec, 0x23, reg);
+	alc_write_coef_idx(codec, 0x24, 0);
+	alc_write_coef_idx(codec, 0x25, val);
+	alc_write_coef_idx(codec, 0x26, 0xb013);
+}
+
+static void alc298_book12_write_table(struct hda_codec *codec,
+				      const struct alc298_book12_reg *table,
+				      int count)
+{
+	int i;
+
+	for (i = 0; i < count; i++)
+		alc298_book12_write_indirect(codec, table[i].reg, table[i].val);
+}
+
+static void alc298_book12_init_amp(struct hda_codec *codec,
+				   unsigned short amp,
+				   const struct alc298_book12_reg *table,
+				   int count)
+{
+	int i;
+
+	for (i = 0; i < count; i++) {
+		snd_hda_codec_write(codec, 0x06, 0,
+				    AC_VERB_SET_DIGI_CONVERT_3, 0x80);
+		alc_update_coef_idx(codec, 0x26, 0x4000, 0x4000);
+		if (!i)
+			alc_write_coef_idx(codec, 0x22, amp);
+		alc_write_coef_idx(codec, 0x23, table[i].reg);
+		alc_write_coef_idx(codec, 0x25, table[i].val);
+		alc_write_coef_idx(codec, 0x26, 0xb010);
+		snd_hda_codec_write(codec, 0x06, 0,
+				    AC_VERB_SET_DIGI_CONVERT_3, 0x00);
+		alc_update_coef_idx(codec, 0x26, 0x0010, 0);
+	}
+}
+
+static void alc298_book12_set_route(struct hda_codec *codec, bool headphones)
+{
+	const struct alc298_book12_reg *route;
+	int count;
+
+	if (headphones) {
+		route = alc298_book12_headphone_route;
+		count = ARRAY_SIZE(alc298_book12_headphone_route);
+	} else {
+		route = alc298_book12_speaker_route;
+		count = ARRAY_SIZE(alc298_book12_speaker_route);
+	}
+
+	alc_write_coef_idx(codec, 0x22, 0x1b);
+	alc298_book12_write_table(codec, route, count);
+}
+
+static void alc298_book12_switch_output(struct hda_codec *codec)
+{
+	bool headphones;
+	unsigned int left, right;
+
+	headphones = snd_hda_jack_detect_state(codec, 0x18) ==
+		HDA_JACK_PRESENT;
+	left = snd_hda_codec_amp_read(codec, 0x17, 0, HDA_OUTPUT, 0);
+	right = snd_hda_codec_amp_read(codec, 0x17, 1, HDA_OUTPUT, 0);
+
+	/* Silence the shared physical output while the vendor route changes. */
+	snd_hda_codec_amp_update(codec, 0x17, 0, HDA_OUTPUT, 0,
+				 HDA_AMP_MUTE, HDA_AMP_MUTE);
+	snd_hda_codec_amp_update(codec, 0x17, 1, HDA_OUTPUT, 0,
+				 HDA_AMP_MUTE, HDA_AMP_MUTE);
+	alc298_book12_set_route(codec, headphones);
+	snd_hda_codec_amp_update(codec, 0x17, 0, HDA_OUTPUT, 0,
+				 HDA_AMP_MUTE, left & HDA_AMP_MUTE);
+	snd_hda_codec_amp_update(codec, 0x17, 1, HDA_OUTPUT, 0,
+				 HDA_AMP_MUTE, right & HDA_AMP_MUTE);
+
+	codec_dbg(codec, "Galaxy Book 12: selected %s route\n",
+		  headphones ? "headphone" : "speaker");
+}
+
+static void alc298_book12_jack_callback(struct hda_codec *codec,
+					struct hda_jack_callback *jack)
+{
+	alc298_book12_switch_output(codec);
+}
+
+static void alc298_fixup_samsung_galaxy_book12(struct hda_codec *codec,
+					       const struct hda_fixup *fix,
+					       int action)
+{
+	struct hda_jack_callback *cb;
+	hda_jack_callback_fn cb_func = alc298_book12_jack_callback;
+	unsigned int left, right;
+	bool headphones;
+
+	switch (action) {
+	case HDA_FIXUP_ACT_PROBE:
+		cb = snd_hda_jack_detect_enable_callback(codec, 0x18, cb_func);
+		if (IS_ERR(cb))
+			codec_warn(codec, "Galaxy Book 12: jack callback failed\n");
+		break;
+	case HDA_FIXUP_ACT_INIT:
+		left = snd_hda_codec_amp_read(codec, 0x17, 0, HDA_OUTPUT, 0);
+		right = snd_hda_codec_amp_read(codec, 0x17, 1, HDA_OUTPUT, 0);
+		snd_hda_codec_amp_stereo(codec, 0x17, HDA_OUTPUT, 0,
+					 HDA_AMP_MUTE, HDA_AMP_MUTE);
+		alc_update_coef_idx(codec, 0x26, 0x3000, 0x3000);
+		alc298_book12_init_amp(codec, 0x31, alc298_book12_amp_left,
+				       ARRAY_SIZE(alc298_book12_amp_left));
+		alc298_book12_init_amp(codec, 0x34, alc298_book12_amp_right,
+				       ARRAY_SIZE(alc298_book12_amp_right));
+		alc_write_coef_idx(codec, 0x22, 0x1b);
+		alc298_book12_write_table(codec, alc298_book12_dsp,
+					  ARRAY_SIZE(alc298_book12_dsp));
+		headphones = snd_hda_jack_detect_state(codec, 0x18) ==
+			HDA_JACK_PRESENT;
+		alc298_book12_set_route(codec, headphones);
+		snd_hda_codec_amp_update(codec, 0x17, 0, HDA_OUTPUT, 0,
+					 HDA_AMP_MUTE, left & HDA_AMP_MUTE);
+		snd_hda_codec_amp_update(codec, 0x17, 1, HDA_OUTPUT, 0,
+					 HDA_AMP_MUTE, right & HDA_AMP_MUTE);
+		break;
+	}
+}
