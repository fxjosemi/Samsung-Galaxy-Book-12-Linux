From: Galaxy Book 12 Linux contributors
Subject: [PATCH] media: i2c: imx258: add 26 MHz input-clock support

The Samsung Galaxy Book 12 supplies 26 MHz to its rear IMX258 sensor.
The sensor accepts 6--27 MHz, but the upstream driver only contains PLL
tables for 19.2 and 24 MHz and rejects the device during probe.

Add the 26 MHz PLL settings recovered from Samsung's official SM-W720 Windows
driver.  The vendor tables use exact 1300 and 643.5 Mbps lane rates (650 and
321.75 MHz link frequencies), rather than rescaling the upstream 19.2 MHz
tables.  Keeping those values exact is important because the IPU3 receiver and
the sensor must advertise the same frequencies.

--- a/drivers/media/i2c/imx258.c
+++ b/drivers/media/i2c/imx258.c
@@ -316,6 +316,74 @@ static const struct cci_reg_sequence mipi_642mbps_24mhz_4l[] = {
 	{ IMX258_REG_REQ_LINK_BIT_RATE_MBPS_L, 0 },
 };
 
+static const struct cci_reg_sequence mipi_1300mbps_26mhz_2l[] = {
+	{ IMX258_REG_EXCK_FREQ, 0x1a00 },
+	{ IMX258_REG_IVTPXCK_DIV, 10 },
+	{ IMX258_REG_IVTSYCK_DIV, 2 },
+	{ IMX258_REG_PREPLLCK_VT_DIV, 2 },
+	{ IMX258_REG_PLL_IVT_MPY, 100 },
+	{ IMX258_REG_IOPPXCK_DIV, 10 },
+	{ IMX258_REG_IOPSYCK_DIV, 1 },
+	{ IMX258_REG_PREPLLCK_OP_DIV, 2 },
+	{ IMX258_REG_PLL_IOP_MPY, 216 },
+	{ IMX258_REG_PLL_MULT_DRIV, 0 },
+
+	{ IMX258_REG_CSI_LANE_MODE, 1 },
+	{ IMX258_REG_REQ_LINK_BIT_RATE_MBPS_H, 1300 * 2 },
+	{ IMX258_REG_REQ_LINK_BIT_RATE_MBPS_L, 0 },
+};
+
+static const struct cci_reg_sequence mipi_1300mbps_26mhz_4l[] = {
+	{ IMX258_REG_EXCK_FREQ, 0x1a00 },
+	{ IMX258_REG_IVTPXCK_DIV, 5 },
+	{ IMX258_REG_IVTSYCK_DIV, 2 },
+	{ IMX258_REG_PREPLLCK_VT_DIV, 2 },
+	{ IMX258_REG_PLL_IVT_MPY, 100 },
+	{ IMX258_REG_IOPPXCK_DIV, 10 },
+	{ IMX258_REG_IOPSYCK_DIV, 1 },
+	{ IMX258_REG_PREPLLCK_OP_DIV, 2 },
+	{ IMX258_REG_PLL_IOP_MPY, 216 },
+	{ IMX258_REG_PLL_MULT_DRIV, 0 },
+
+	{ IMX258_REG_CSI_LANE_MODE, 3 },
+	{ IMX258_REG_REQ_LINK_BIT_RATE_MBPS_H, 1300 * 4 },
+	{ IMX258_REG_REQ_LINK_BIT_RATE_MBPS_L, 0 },
+};
+
+static const struct cci_reg_sequence mipi_643_5mbps_26mhz_2l[] = {
+	{ IMX258_REG_EXCK_FREQ, 0x1a00 },
+	{ IMX258_REG_IVTPXCK_DIV, 5 },
+	{ IMX258_REG_IVTSYCK_DIV, 2 },
+	{ IMX258_REG_PREPLLCK_VT_DIV, 4 },
+	{ IMX258_REG_PLL_IVT_MPY, 99 },
+	{ IMX258_REG_IOPPXCK_DIV, 10 },
+	{ IMX258_REG_IOPSYCK_DIV, 1 },
+	{ IMX258_REG_PREPLLCK_OP_DIV, 2 },
+	{ IMX258_REG_PLL_IOP_MPY, 216 },
+	{ IMX258_REG_PLL_MULT_DRIV, 0 },
+
+	{ IMX258_REG_CSI_LANE_MODE, 1 },
+	{ IMX258_REG_REQ_LINK_BIT_RATE_MBPS_H, 1287 },
+	{ IMX258_REG_REQ_LINK_BIT_RATE_MBPS_L, 0 },
+};
+
+static const struct cci_reg_sequence mipi_643_5mbps_26mhz_4l[] = {
+	{ IMX258_REG_EXCK_FREQ, 0x1a00 },
+	{ IMX258_REG_IVTPXCK_DIV, 5 },
+	{ IMX258_REG_IVTSYCK_DIV, 2 },
+	{ IMX258_REG_PREPLLCK_VT_DIV, 4 },
+	{ IMX258_REG_PLL_IVT_MPY, 99 },
+	{ IMX258_REG_IOPPXCK_DIV, 10 },
+	{ IMX258_REG_IOPSYCK_DIV, 1 },
+	{ IMX258_REG_PREPLLCK_OP_DIV, 2 },
+	{ IMX258_REG_PLL_IOP_MPY, 216 },
+	{ IMX258_REG_PLL_MULT_DRIV, 0 },
+
+	{ IMX258_REG_CSI_LANE_MODE, 3 },
+	{ IMX258_REG_REQ_LINK_BIT_RATE_MBPS_H, 2574 },
+	{ IMX258_REG_REQ_LINK_BIT_RATE_MBPS_L, 0 },
+};
+
 static const struct cci_reg_sequence mode_common_regs[] = {
 	{ CCI_REG8(0x3051), 0x00 },
 	{ CCI_REG8(0x6B11), 0xCF },
@@ -568,6 +636,11 @@ static const s64 link_freq_menu_items_24[] = {
-	321000000ULL,
+	321000000ULL,
 };

+static const s64 link_freq_menu_items_26[] = {
+	650000000ULL,
+	321750000ULL,
+};
+
 #define REGS(_list) { .num_of_regs = ARRAY_SIZE(_list), .regs = _list, }

 /* Link frequency configs */
@@ -591,6 +664,35 @@ static const struct imx258_link_freq_config link_freq_configs_24[] = {
 	},
 };
 
+static const struct imx258_link_freq_config link_freq_configs_26[] = {
+	[IMX258_LINK_FREQ_1267MBPS] = {
+		.pixels_per_line = IMX258_PPL_DEFAULT,
+		.link_cfg = {
+			[IMX258_2_LANE_MODE] = {
+				.lf_to_pix_rate_factor = 2 * 2,
+				.reg_list = REGS(mipi_1300mbps_26mhz_2l),
+			},
+			[IMX258_4_LANE_MODE] = {
+				.lf_to_pix_rate_factor = 4,
+				.reg_list = REGS(mipi_1300mbps_26mhz_4l),
+			},
+		}
+	},
+	[IMX258_LINK_FREQ_640MBPS] = {
+		.pixels_per_line = IMX258_PPL_DEFAULT,
+		.link_cfg = {
+			[IMX258_2_LANE_MODE] = {
+				.lf_to_pix_rate_factor = 2,
+				.reg_list = REGS(mipi_643_5mbps_26mhz_2l),
+			},
+			[IMX258_4_LANE_MODE] = {
+				.lf_to_pix_rate_factor = 4,
+				.reg_list = REGS(mipi_643_5mbps_26mhz_4l),
+			},
+		}
+	},
+};
+
 /* Mode configs */
 static const struct imx258_mode supported_modes[] = {
 	{
@@ -1404,6 +1506,10 @@ static int imx258_probe(struct i2c_client *client)
 		imx258->link_freq_configs = link_freq_configs_24;
 		imx258->link_freq_menu_items = link_freq_menu_items_24;
 		break;
+	case 26000000:
+		imx258->link_freq_configs = link_freq_configs_26;
+		imx258->link_freq_menu_items = link_freq_menu_items_26;
+		break;
 	default:
 		dev_err(imx258->dev, "input clock frequency of %u not supported\n",
 			val);
